# ============================================================
# Claude WeChat Bot Configuration
# Copy to .env:  cp .env.example .env
# Based on Tencent ilink official API
# ============================================================

# ── API Key (required) ─────────────────────────────────────
# Get your key from https://api.deepseek.com (Anthropic-compatible API)
ANTHROPIC_API_KEY=sk-your-api-key-here
# API endpoint is auto-selected based on model:
#   deepseek-*  →  https://api.deepseek.com/anthropic (official)
#   claude-*    →  default Anthropic API
# Optional: set ANTHROPIC_BASE_URL to override (leave empty for auto)
# ANTHROPIC_BASE_URL=
# Model: deepseek-v4-pro, claude-sonnet-4-20250514, etc.
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# ── Access Control ─────────────────────────────────────────
# Comma-separated WeChat user IDs, or "*" for everyone
ALLOWED_USERS=*
ALLOWED_ROOMS=*

# ── Auto Reply ─────────────────────────────────────────────
AUTO_REPLY_ENABLED=true
# Minimum seconds between replies to the same user/group
AUTO_REPLY_COOLDOWN=5

# ── Conversation ───────────────────────────────────────────
# Max pairs of user+assistant messages kept in memory
CONVERSATION_MAX_TURNS=20
CONVERSATION_TTL_MINUTES=60

# ── Bot Identity ───────────────────────────────────────────
BOT_NAME=Claude

# ── Admin ──────────────────────────────────────────────────
# Admin web panel port (default 8080)
ADMIN_PORT=8080

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
DATA_DIR=./data
